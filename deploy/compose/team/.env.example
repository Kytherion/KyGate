# Copy to .env and fill in. Never commit .env: it holds secrets.

# The master key, the same for every KyGate process. Either the key itself,
# 32 bytes, base64 (openssl rand -base64 32); keep a copy somewhere safe:
KYGATE_MASTER_KEY=
# or the key wrapped by Vault or a cloud KMS, from 'kygate master-key new --kms URI',
# with the service's access (VAULT_ADDR and VAULT_TOKEN, or VAULT_ROLE_ID and VAULT_SECRET_ID):
# KYGATE_MASTER_KEY_WRAPPED=
# VAULT_ADDR=

# The PostgreSQL password KyGate uses.
POSTGRES_PASSWORD=

# Provider keys (optional here: they can also be stored, sealed, from the console).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The Guard, when started with --profile guard (gateways reach guard1; calls
# are spread over every address the Guard's name resolves to).
# KYGATE_GUARD=guard1:4002

# Memory of the exact cache (Valkey).
# KYGATE_CACHE_MEMORY=1gb

# Published ports, on the loopback interface (model API, console).
# KYGATE_PORT=4000
# KYGATE_CONSOLE_PORT=4001
