# One address for clients, spread over the two gateways. A gateway that fails
# its health check gets no new requests. Streams (server-sent events) pass
# through as they come.
:4000 {
	reverse_proxy gateway1:4000 gateway2:4000 {
		lb_policy round_robin
		health_uri /healthz
		health_interval 5s
		flush_interval -1
		transport http {
			read_timeout 10m
		}
	}
}
